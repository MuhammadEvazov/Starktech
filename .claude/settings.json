{
  "permissions": {
    "allow": [
      "Bash(dotnet restore *)",
      "Bash(dotnet build *)",
      "Bash(docker compose *)",
      "Bash(docker exec *)",
      "Bash(tasklist //FI \"PID eq 18488\")",
      "Bash(tasklist //FI \"IMAGENAME eq dotnet.exe\" //FO CSV)",
      "Bash(netstat -ano)",
      "PowerShell(Get-CimInstance Win32_Process -Filter \"Name='dotnet.exe'\")",
      "Bash(curl -s -X POST http://localhost:5076/api/auth/login -H 'accept: */*' -H 'Content-Type: application/json' -d '{\"email\":\"admin@starktech.tj\",\"password\":\"Admin123!\"}')",
      "PowerShell(Stop-Process -Id 27828 -Force)",
      "PowerShell(Get-Process -Id 4008 -ErrorAction SilentlyContinue)",
      "PowerShell(Stop-Process -Id 4008 -Force)",
      "Bash(dotnet tool *)",
      "Bash(dotnet ef *)",
      "PowerShell(Stop-Process -Id 21224 -Force -ErrorAction SilentlyContinue)",
      "PowerShell(Get-Process -Id 21224 -ErrorAction SilentlyContinue)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" http://localhost:5076/swagger/v1/swagger.json)",
      "Bash(curl -s -w '\\\\nSTATUS:%{http_code}\\\\n' -X POST http://localhost:5076/api/auth/login -H 'Content-Type: application/json' -d '{\"email\":\"admin@starktech.tj\",\"password\":\"Admin123!\"}')",
      "PowerShell(Stop-Process -Id 11608 -Force -ErrorAction SilentlyContinue)"
    ]
  }
}
